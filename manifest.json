{
  "manifest_version": 3,
  "name": "FACEIT Ping Override — Pathfinder",
  "version": "1.8.0",
  "description": "Browser-side FACEIT ping override with Vladivostok server health alerts, queue protection, RU proxy routing, and Discord alerts.",
  "permissions": [
    "storage",
    "proxy",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.faceit.com/*",
    "https://api.github.com/*",
    "https://*.ping.faceit.com/*",
    "https://ipapi.co/*",
    "https://api.ipify.org/*",
    "https://discord.com/api/webhooks/*",
    "https://canary.discord.com/api/webhooks/*",
    "https://ptb.discord.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FACEIT Ping Override — Pathfinder"
  },
  "icons": {
    "128": "pathfinder-upper.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": [
        "ping-main.js",
        "health-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": [
        "notice.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pathfinder-upper.png"
      ],
      "matches": [
        "https://www.faceit.com/*"
      ]
    }
  ]
}